
<template>
  <div class="page">

    <!-- ENCABEZADO -->
    <div class="header">
      <text class="logo">KHRONOS</text>
      <text class="subtitle">Mathius Zamora</text>
    </div>

    <!-- FASE ACTUAL -->
    <div class="timer-card">
      <text class="phase-caption">FASE ACTUAL</text>
      <text class="phase">{{ phaseLabel }}</text>
      <text class="time">{{ timeText }}</text>
      <text class="remaining">TIEMPO RESTANTE</text>
    </div>

    <!-- INFORMACION -->
    <div class="info-row">

      <div class="info-card">
        <text class="info-label">SIGUIENTE</text>
        <text class="info-value">
          {{ phase === 'rest' ? 'SERIE' : 'DESCANSO' }}
        </text>
        <text class="info-time">
          {{ phase === 'rest' ? fmt(setSec) : fmt(restSec) }}
        </text>
      </div>

      <div class="info-card">
        <text class="info-label">CONTADOR</text>
        <text class="info-value">SERIES</text>
        <text class="info-time">{{ setCount }}</text>
      </div>

    </div>

    <!-- BOTON PRINCIPAL -->
    <input
      class="btn"
      type="button"
      value="{{ btnText }}"
      onclick="onTap"
    />

    <!-- PIE -->
    <text class="footer">
      ALTERNANCIA AUTOMATICA ACTIVADA
    </text>

  </div>
</template>

<script>
import vibrator from '@system.vibrator'

export default {
  data: {
    phase: 'idle',
    running: false,
    seconds: 0,

    restSec: 180,
    setSec: 90,

    setCount: 0,
    timer: null,

    phaseLabel: 'LISTO',
    timeText: '03:00',
    btnText: 'INICIAR'
  },

  fmt(s) {
    const m = Math.floor(s / 60)
    const r = s % 60

    return (m < 10 ? '0' : '') + m + ':' +
           (r < 10 ? '0' : '') + r
  },

  onTap() {
    if (this.phase === 'idle') {
      this.startPhase('rest')

    } else if (this.running) {
      this.clear()
      this.running = false
      this.btnText = 'REANUDAR'

    } else {
      this.running = true
      this.btnText = 'PAUSAR'
      this.tick()
    }
  },

  startPhase(p) {
    this.clear()

    this.phase = p
    this.running = true
    this.btnText = 'PAUSAR'

    if (p === 'rest') {
      this.seconds = this.restSec
      this.phaseLabel = 'DESCANSO'
    } else {
      this.seconds = this.setSec
      this.phaseLabel = 'SERIE'
      this.setCount++
    }

    this.timeText = this.fmt(this.seconds)
    this.tick()
  },


  tick() {
  this.clear()

  this.timer = setInterval(() => {
    this.seconds--

    this.timeText = this.fmt(this.seconds)

    // Aviso cuando quedan 25 segundos de descanso
    if (this.phase === 'rest' && this.seconds === 25) {
      vibrator.vibrate({ mode: 'short' })
    }

    // Finalizacion de la fase
    if (this.seconds <= 0) {
      vibrator.vibrate({ mode: 'long' })

      this.startPhase(
        this.phase === 'rest' ? 'set' : 'rest'
      )
    }

  }, 1000)
},


  clear() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  onDestroy() {
    this.clear()
  }
}
</script>

