<template>
  <div class="page">
    <text class="phase">{{ phaseLabel }}</text>
    <text class="time">{{ timeText }}</text>
    <text class="count">Serie {{ setCount }}</text>
    <input class="btn" type="button" value="{{ btnText }}" onclick="onTap" />
  </div>
</template>

<script>
import vibrator from '@system.vibrator'

export default {
  data: {
    phase: 'idle',        // idle | rest | set
    running: false,
    seconds: 0,
    restSec: 180,         // descanso: 3:00
    setSec: 90,           // serie: 1:30
    setCount: 0,
    timer: null,
    phaseLabel: 'Listo',
    timeText: '03:00',
    btnText: 'Iniciar'
  },

  fmt(s) {
    const m = Math.floor(s / 60)
    const r = s % 60
    return (m < 10 ? '0' : '') + m + ':' + (r < 10 ? '0' : '') + r
  },

  onTap() {
    if (this.phase === 'idle') {
      this.startPhase('rest')
    } else if (this.running) {
      this.clear()
      this.running = false
      this.btnText = 'Reanudar'
    } else {
      this.running = true
      this.btnText = 'Pausar'
      this.tick()
    }
  },

  startPhase(p) {
    this.clear()
    this.phase = p
    this.running = true
    this.btnText = 'Pausar'
    if (p === 'rest') {
      this.seconds = this.restSec
      this.phaseLabel = 'Descanso'
    } else {
      this.seconds = this.setSec
      this.phaseLabel = 'Serie'
      this.setCount++
    }
    this.timeText = this.fmt(this.seconds)
    this.tick()
  },

  tick() {
    this.clear()
    this.timer = setInterval(() => {
      this.seconds--
      this.timeText = this.fmt(this.seconds)
      if (this.seconds <= 0) {
        vibrator.vibrate({ mode: 'long' })
        // cambia solo a la otra fase, en bucle infinito
        this.startPhase(this.phase === 'rest' ? 'set' : 'rest')
      }
    }, 1000)
  },

  clear() {
    if (this.timer) { clearInterval(this.timer); this.timer = null }
  },

  onDestroy() { this.clear() }
}
</script>

<style>
.page { flex-direction: column; justify-content: center; align-items: center; width: 100%; height: 100%; background-color: #000000; }
.phase { font-size: 28px; color: #aaaaaa; }
.time { font-size: 64px; color: #ffffff; margin: 8px 0; }
.count { font-size: 24px; color: #00b300; margin-bottom: 12px; }
.btn { width: 80%; height: 56px; background-color: #00b300; color: #ffffff; border-radius: 28px; }
</style>