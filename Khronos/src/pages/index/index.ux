}

.time {
  font-size: 44px;
  font-weight: bold;
  color: #FFFFFF;
  width: 100%;
  text-align: center;
  margin-top: 8px;
}

.remaining {
  font-size: 11px;
  color: #8998A5;
  margin-top: 4px;
}

.info-row {
  flex-direction: row;
  justify-content: space-between;
  width: 100%;
}

.info-card {
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 48%;
  padding: 10px 0;
  background-color: #17212A;
  border-radius: 12px;
}

.info-label {
  font-size: 9px;
  color: #8998A5;
}

.info-value {
  font-size: 12px;
